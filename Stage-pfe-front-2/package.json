    "cni-api:download": "cmd /c copy D:\\stage_pfe_cni\\Crud-version-cni\\target\\Gestion_centre_formation_backend-0.0.1-SNAPSHOT.jar tools\\swagger\\dist\\ && cmd /c copy D:\\stage_pfe_cni\\Crud-version-cni\\target\\swagger.json tools\\swagger\\src\\",
    "cni-api:extract": "node ./tools/swagger/src/swagger.json",
    "cni-api:swagger-gen": "npx ng-swagger-gen -i ./tools/swagger/src/swagger.json -o src/cni-api/src"
  },
